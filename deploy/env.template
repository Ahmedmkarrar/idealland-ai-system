# Production .env.local template.
# Copy to project root as .env.local, fill in real values.
# NEVER commit the filled-in version.

# --- Auth ---
# Generate fresh: openssl rand -base64 24
DASHBOARD_PASSWORD=

# --- Cron security ---
# Generate fresh: openssl rand -hex 32
CRON_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Telegram alerts (PRIMARY internal channel — instant push, no DNS) ---
# 1. Message @BotFather → /newbot → copy the token below.
# 2. Add the bot to your chat/group, send it any message.
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates → copy "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (Resend — for external cold outreach; needs verified domain) ---
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@idealland.co.uk
ALERT_EMAIL_TO=admin@idealland.co.uk

# --- Mailing (Mixmax — OPTIONAL, falls back to Resend) ---
MIXMAX_API_KEY=
MIXMAX_WEBHOOK_SECRET=

# --- Invoicing (Xero — OPTIONAL, invoices mark sent locally when blank) ---
# Create dev app at https://developer.xero.com
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://your-domain.tld/api/invoicing/xero/callback
XERO_TENANT_ID=
XERO_ACCESS_TOKEN=
XERO_REFRESH_TOKEN=

# --- Land Registry ---
HMLR_API_KEY=

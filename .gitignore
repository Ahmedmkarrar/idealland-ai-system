# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Local SQLite DB — production creates its own via `prisma migrate deploy`
prisma/dev.db
prisma/dev.db-journal
prisma/*.db-journal

# Runtime-generated files (AI images). Ignored so `git pull --ff-only` on the
# droplet stays clean; the dir is created on demand and survives deploys.
/storage

# OS
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Build artefacts that don't belong in git
.tsbuildinfo

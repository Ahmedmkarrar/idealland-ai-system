generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model PlanningApplication {
  id          String   @id @default(cuid())
  reference   String   @unique
  council     String
  address     String
  description String
  units       Int
  status      String
  applicant   String?
  architect   String?
  submittedAt DateTime
  decidedAt   DateTime?
  alertSent   Boolean  @default(false)
  decisionAlertSent Boolean @default(false)
  // AI analysis (filled in by lib/services/intelligence.ts).
  intelligenceSummary String?
  leadScore           Int?     // 1-10
  leadScoreReason     String?
  analyzedAt          DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   Document[]
  statusHistory ApplicationStatusChange[]
  socialPosts SocialPost[]
  outreachEmails OutreachEmail[]
}

model ApplicationStatusChange {
  id            String   @id @default(cuid())
  applicationId String
  fromStatus    String
  toStatus      String
  changedAt     DateTime @default(now())
  alertSent     Boolean  @default(false)
  application   PlanningApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Document {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  name          String
  url           String?
  fileSize      String?
  status        String
  retrievedAt   DateTime?
  createdAt     DateTime @default(now())
  application   PlanningApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model SocialPost {
  id              String   @id @default(cuid())
  platform        String
  content         String
  imageUrl        String?
  imageGeneratedAt DateTime?
  status          String
  approvalStatus  String   @default("pending_review")
  reviewNote      String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  engagements     Int      @default(0)
  reach           Int      @default(0)
  createdAt       DateTime @default(now())
  applicationId   String?
  application     PlanningApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
}

model AdCampaign {
  id          String   @id @default(cuid())
  name        String
  platform    String
  status      String
  budget      Float
  spent       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  targeting   String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MailingContact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String?
  type      String
  tags      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MailingCampaign {
  id             String   @id @default(cuid())
  subject        String
  content        String
  status         String
  recipientCount Int      @default(0)
  openCount      Int      @default(0)
  clickCount     Int      @default(0)
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  recipients     MailingRecipient[]
}

model MailingRecipient {
  id              String   @id @default(cuid())
  campaignId      String
  email           String
  name            String
  status          String   @default("pending")
  mixmaxMessageId String?
  sentAt          DateTime?
  campaign        MailingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AutomationRun {
  id          String   @id @default(cuid())
  type        String
  status      String
  summary     String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  error       String?
}

// AI-drafted personalized cold email per (planning app, contact) pair.
// Staff reviews on /mailing → approves → sent via Resend.
model OutreachEmail {
  id            String   @id @default(cuid())
  applicationId String
  application   PlanningApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactEmail  String
  contactName   String
  subject       String
  body          String
  status        String   @default("draft") // "draft" | "sent" | "skipped" | "failed"
  sentAt        DateTime?
  resendId      String?
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([applicationId])
  @@index([status])
}

// IdealLand's own paying customers — clients we auto-bill via the invoicing
// module. NOT to be confused with MailingContact (developers/architects we
// market TO on behalf of IdealLand).
model Client {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  billingEmail  String?
  billingModel  String   // "flat_monthly" | "per_application"
  monthlyRate   Float?   // populated when billingModel = flat_monthly
  perUnitRate   Float?   // populated when billingModel = per_application
  currency      String   @default("GBP")
  status        String   @default("active") // "active" | "paused" | "cancelled"
  xeroContactId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoices      Invoice[]
}

model Invoice {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  amount         Float
  currency       String   @default("GBP")
  status         String   @default("draft") // "draft" | "sent" | "paid" | "overdue" | "void"
  lineItems      String   // JSON: [{description, qty, unitAmount}]
  xeroInvoiceId  String?
  xeroInvoiceNum String?
  sentAt         DateTime?
  paidAt         DateTime?
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId, periodStart])
}

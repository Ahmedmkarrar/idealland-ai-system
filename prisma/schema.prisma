generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// HMO (House in Multiple Occupation) records ingested from council public
// licensing registers. Backs the acquisition-sourcing module: identify HMO
// owners likely to sell (individually or as a portfolio). See
// docs/HMO_SOURCING_SPEC.md. Note: licensing registers carry a "not for
// marketing" notice — the list/intelligence layer is the defensible core;
// outreach must favour companies + honour opt-outs.
model HmoProperty {
  id               String    @id @default(cuid())
  // Stable dedupe key for idempotent re-ingest: "<source>:<licence|addrhash>".
  externalKey      String    @unique
  source           String    // e.g. "camden-opendata"
  council          String
  licenceNumber    String?
  licenceType      String?
  status           String?
  propertyAddress  String
  postcode         String?
  holderName       String?
  holderAddress    String?
  managerName      String?
  managerAddress   String?
  maxPersons       Int?
  storeys          Int?
  bedrooms         Int?
  rooms            Int?
  commencementDate DateTime?
  endDate          DateTime?
  latitude         Float?
  longitude        Float?
  // Derived sell-likelihood signals (computed at ingest from register data).
  ownerType        String?   // "company" | "individual" | "unknown"
  portfolioSize    Int       @default(1) // # of HMOs held by the same holder
  sellLikelihood   Int?      // 1-10
  sellReason       String?
  flags            String?   // csv: portfolio,near-expiry,large,company,...
  // AI acquisition layer (Phase 3): Claude-written brief, refined sell score,
  // and a ready-to-send direct-mail approach letter. Cached on the row.
  intelligenceSummary String?
  aiScore          Int?      // Claude's refined 1-10 sell-likelihood (vs deterministic sellLikelihood)
  approachLetter   String?   // draft direct-mail letter to the owner
  approachStatus   String?   // null | "draft" | "approved" | "sent"
  analyzedAt       DateTime?
  letterDraftedAt  DateTime?
  // Companies House enrichment (Phase 2) — only for company-owned HMOs.
  companyNumber      String?   // resolved CH company number
  companyStatus      String?   // "active" | "dissolved" | "liquidation" | ...
  incorporationDate  DateTime? // proxy for how long they've held/operated
  maxDirectorAge     Int?      // oldest active director's age — retirement signal
  directorSummary    String?   // e.g. "Malcolm Haines (78), William Haines (39)"
  enrichedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([council])
  @@index([holderName])
  @@index([sellLikelihood])
}

model PlanningApplication {
  id          String   @id @default(cuid())
  reference   String   @unique
  council     String
  address     String
  description String
  units       Int
  status      String
  applicant   String?
  // Council-owned sites are non-starters — IdealLand can't broker land the
  // borough owns. Derived at ingest from PLD's ownership_status plus the
  // applicant's name; see lib/public-ownership.ts.
  ownershipStatus   String?
  publicOwner       Boolean @default(false)
  publicOwnerReason String?
  architect   String?
  submittedAt DateTime
  decidedAt   DateTime?
  // What the council actually decided ("Approved", "Refused", "Withdrawn", ...).
  // status="decided" only means a decision exists — about a quarter of them are
  // refusals, and the approach letter must not congratulate those on a permission
  // they did not get. From the PLD `decision` field.
  decision    String?
  alertSent   Boolean  @default(false)
  decisionAlertSent Boolean @default(false)
  // AI analysis (filled in by lib/services/intelligence.ts).
  intelligenceSummary String?
  leadScore           Int?     // 1-10
  leadScoreReason     String?
  analyzedAt          DateTime?
  // Link back to the council's own planning-portal page (from PLD url_planning_app).
  // The agent/applicant identity lives there, not in the GLA feed.
  councilUrl          String?
  // The council's OWN reference ("26/01804/FUL", from PLD lpa_app_no). `reference`
  // above is the GLA document id, which no council portal recognises — this is
  // the one to type into a planning search, and the feed carries it for every
  // application even when it gives us no link. See lib/planning-portals.ts.
  lpaReference        String?
  // Verified deep link to a planning-register mirror (PlanIndex), for the ~30% of
  // applications whose council publishes no direct link of its own. Written only
  // after a request confirms the page exists — see lib/planning-portals.ts.
  mirrorUrl           String?
  // Contact discovery — who filed the application and how to reach them. This is
  // the labour-intensive step (agent name + firm + email) IdealLand does by hand.
  agentName           String?
  agentFirm           String?
  agentEmail          String?
  agentPhone          String?
  agentWebsite        String?
  contactStatus       String?  // null | "researching" | "found" | "not_found"
  contactNotes        String?
  contactResearchedAt DateTime?
  // Seller-approach email drafted to the agent ("is the owner open to selling?").
  approachSubject     String?
  approachBody        String?
  approachStatus      String?  // null | "drafted" | "sent"
  approachSentAt      DateTime?
  approachOutcome     String?  // null | "replied" | "interested" | "dead" | "won"
  approachOutcomeAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   Document[]
  statusHistory ApplicationStatusChange[]
  socialPosts SocialPost[]
  outreachEmails OutreachEmail[]
}

model ApplicationStatusChange {
  id            String   @id @default(cuid())
  applicationId String
  fromStatus    String
  toStatus      String
  changedAt     DateTime @default(now())
  alertSent     Boolean  @default(false)
  application   PlanningApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Document {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  name          String
  url           String?
  fileSize      String?
  status        String
  retrievedAt   DateTime?
  createdAt     DateTime @default(now())
  application   PlanningApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model SocialPost {
  id              String   @id @default(cuid())
  platform        String
  content         String
  // The provider's original URL. DALL-E's expires after ~1 hour, so it is kept
  // for provenance only — never render it. Render imagePath instead.
  imageUrl        String?
  // Filename of the image persisted to local disk at generation time, served
  // via /api/images/[file]. Null when generation failed or predates persistence.
  imagePath       String?
  imageGeneratedAt DateTime?
  status          String
  approvalStatus  String   @default("pending_review")
  reviewNote      String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  engagements     Int      @default(0)
  reach           Int      @default(0)
  createdAt       DateTime @default(now())
  applicationId   String?
  application     PlanningApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
}

model AdCampaign {
  id          String   @id @default(cuid())
  name        String
  platform    String
  status      String
  budget      Float
  spent       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  targeting   String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MailingContact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String?
  type      String
  tags      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MailingCampaign {
  id             String   @id @default(cuid())
  subject        String
  content        String
  status         String
  recipientCount Int      @default(0)
  openCount      Int      @default(0)
  clickCount     Int      @default(0)
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  recipients     MailingRecipient[]
}

model MailingRecipient {
  id              String   @id @default(cuid())
  campaignId      String
  email           String
  name            String
  status          String   @default("pending")
  mixmaxMessageId String?
  sentAt          DateTime?
  campaign        MailingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AutomationRun {
  id          String   @id @default(cuid())
  type        String
  status      String
  summary     String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  error       String?
}

// AI-drafted personalized cold email per (planning app, contact) pair.
// Staff reviews on /mailing → approves → sent via Resend.
model OutreachEmail {
  id            String   @id @default(cuid())
  applicationId String
  application   PlanningApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactEmail  String
  contactName   String
  subject       String
  body          String
  // Delivery state only — how far the email got. Kept separate from `outcome`
  // so a reply never overwrites the record of whether we actually sent.
  status        String   @default("draft") // "draft" | "sent" | "failed"
  // What came back. Null until staff records it on the dashboard.
  outcome       String?  // "replied" | "interested" | "dead" | "closed-won"
  outcomeAt     DateTime?
  sentAt        DateTime?
  resendId      String?
  errorMessage  String?
  createdAt     DateTime @default(now())

  // One draft per contact per application. Also closes the check-then-write
  // race where two concurrent POSTs both drafted a full set of five.
  @@unique([applicationId, contactEmail])
  @@index([applicationId])
  @@index([status])
  // Backs the per-contact cooldown lookup in pickContacts().
  @@index([contactEmail, createdAt])
  @@index([outcome])
}

// IdealLand's own paying customers — clients we auto-bill via the invoicing
// module. NOT to be confused with MailingContact (developers/architects we
// market TO on behalf of IdealLand).
model Client {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  billingEmail  String?
  billingModel  String   // "flat_monthly" | "per_application"
  monthlyRate   Float?   // populated when billingModel = flat_monthly
  perUnitRate   Float?   // populated when billingModel = per_application
  currency      String   @default("GBP")
  status        String   @default("active") // "active" | "paused" | "cancelled"
  xeroContactId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoices      Invoice[]
}

model Invoice {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  amount         Float
  currency       String   @default("GBP")
  status         String   @default("draft") // "draft" | "sent" | "paid" | "overdue" | "void"
  lineItems      String   // JSON: [{description, qty, unitAmount}]
  xeroInvoiceId  String?
  xeroInvoiceNum String?
  sentAt         DateTime?
  paidAt         DateTime?
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId, periodStart])
}
